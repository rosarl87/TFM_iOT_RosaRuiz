    {
        "id": "125b40aa3603e5b2",
        "type": "function",
        "z": "a9aa710d27c4f7a6",
        "name": "Preparar llamada al dispositivo",
        "func": "const action = flow.get('pendingAction');\nmsg.headers = {\n    'Authorization': 'Bearer ' + msg.payload.access_token,\n    'Content-Type': 'application/json'\n};\nmsg.payload = { socket: { default: { state: action.state } } };\nmsg.url = 'http://192.168.1.133:8000/api/v1/devices/' + action.deviceId;\nreturn msg;",
        "outputs": 1,
        "x": 460,
        "y": 220,
        "wires": [
