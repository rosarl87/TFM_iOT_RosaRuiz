    {
        "id": "24e1cae291495eea",
        "type": "function",
        "z": "a9aa710d27c4f7a6",
        "name": "Guardar acción y preparar token",
        "func": "flow.set('pendingAction', msg.payload);\nmsg.headers = { 'Content-Type': 'application/json' };\nmsg.payload = {\n    grant_type: 'client_credentials',\n    client_id: env.get('SCHUKO_CLIENT_ID'),\n    client_secret: env.get('SCHUKO_CLIENT_SECRET')\n};\nreturn msg;",
        "outputs": 1,
        "x": 440,
        "y": 130,
        "wires": [
            [
                "c513951c66e9d497"
            ]
        ]
    },
